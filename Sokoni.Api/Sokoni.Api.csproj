<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sokoni</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Pure C# Opus decoder for WhatsApp voice notes (no ffmpeg needed on the host). Keep on 1.x: 2.x changed the API. -->
    <PackageReference Include="Concentus" Version="1.1.7" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\schema.sql" />
  </ItemGroup>

</Project>
